{
    "transform": {
        "^.+\\.tsx?$": "babel-jest"
    },
    "testMatch": [
        "**/?(*.)+(spec).[jt]s?(x)"
    ],
    "collectCoverage": false,
    "collectCoverageFrom": [
        "./src/feature/editor/controller/**/*.ts",
        "!**/*.d.ts",
        "!**/index.ts",
        "!**/view/**",
        "!**/type/**",
        "!**/enum/**",
        "!**/context/**"
    ],
    "coverageReporters": [
        "text"
    ]
}