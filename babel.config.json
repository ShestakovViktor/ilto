{
    "presets": [
        "@babel/preset-env",
        "@babel/preset-typescript",
        "solid"
    ],
    "plugins": [
        [
            "module-resolver",
            {
                "alias": {
                    "@src": "./src/",
                    "@src/*": "./src/*",
                    "@res": "./res",
                    "@res/*": "./res/*"
                }
            }
        ]
    ]
}